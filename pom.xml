<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ── Coordenadas do projeto ─────────────────────────────────────────── -->
    <groupId>com.cnpj</groupId>
    <artifactId>cnpj-semanal</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Relatório Semanal CNPJ</name>
    <description>
        Baixa, filtra e exporta CNPJs novos da Receita Federal semanalmente.
    </description>

    <!-- ── Propriedades globais ───────────────────────────────────────────── -->
    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Versões centralizadas — atualize aqui para propagar em todo o POM -->
        <poi.version>5.2.5</poi.version>
        <commons-csv.version>1.11.0</commons-csv.version>
        <httpclient.version>5.3.1</httpclient.version>
        <slf4j.version>2.0.13</slf4j.version>
        <logback.version>1.5.6</logback.version>
    </properties>

    <!-- ── Dependências ──────────────────────────────────────────────────── -->
    <dependencies>

        <!-- Apache POI — geração do .xlsx -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
        </dependency>

        <!-- Apache Commons CSV — leitura dos CSVs da Receita Federal -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
            <version>${commons-csv.version}</version>
        </dependency>

        <!-- Apache HttpClient 5 — download dos ZIPs da Receita Federal -->
        <dependency>
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
            <version>${httpclient.version}</version>
        </dependency>

        <!-- SLF4J API — fachada de logging usada pelo código da aplicação -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <!-- Logback — implementação SLF4J em runtime -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Redireciona os logs internos do Apache POI/HttpClient para SLF4J -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>jul-to-slf4j</artifactId>
            <version>${slf4j.version}</version>
            <scope>runtime</scope>
        </dependency>

    </dependencies>

    <!-- ── Build ─────────────────────────────────────────────────────────── -->
    <build>
        <plugins>

            <!-- Compilador Java 17 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!--
                maven-assembly-plugin
                Gera um fat JAR executável único: target/cnpj-semanal.jar
                Inclui todas as dependências transitivas, essencial para o
                GitHub Actions rodar sem instalar nada extra.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.7.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.cnpj.Main</mainClass>
                        </manifest>
                    </archive>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                    <!-- Renomeia o artefato final para cnpj-semanal.jar -->
                    <finalName>cnpj-semanal</finalName>
                    <!-- Remove o sufixo "-jar-with-dependencies" do nome -->
                    <appendAssemblyId>false</appendAssemblyId>
                </configuration>
                <executions>
                    <execution>
                        <id>fat-jar</id>
                        <!-- Vincula ao phase "package" → mvn package já basta -->
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>
